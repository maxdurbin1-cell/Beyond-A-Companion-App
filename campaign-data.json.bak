                "type": "ruins",
                "name": "The Fallen Hall",
                "data": {
                  "builder": "Sages",
                  "builtFor": "Archive of forbidden records",
                  "novelty": "The walls are warm to the touch and occasionally pulse",
                  "construction": "Fused metal and crystal",
                  "entrance": "A door of solid iron with no handle — opens only from inside",
                  "rooms": 5
