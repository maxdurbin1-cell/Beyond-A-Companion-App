                "type": "lostcity",
                "name": "Lost City",
                "data": {
                  "buildingCondition": "Broken, but still majestic — like a fractured crown.",
                  "buildingThis": "A riot of styles tortured into a single impossible building",
                  "buildingMade": "Flowering mosses and megaliths — impossibly green",
                  "buildingFor": "Strange and unethical experiments",
                  "buildingInside": "Empty but for desperate memories scratched into the walls",
                  "buildingNow": "Empty of everything but a slowly growing mountain of terror",
                  "discovery": {
                    "shape": "Tower",
                    "appearance": "Divine",
                    "fn": "Soul Decomposition",
                    "creator": "Architect",
