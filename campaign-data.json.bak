                "type": "dwelling",
                "name": "Nomad Camp",
                "data": {
                  "mood": "Dilapidated but inhabited",
                  "nomad": "A cartographer sketching roads that no longer exist",
                  "food": "Hearty herbal stew and dark bread",
                  "goods": "Iron tools and nails",
                  "news": "Bandits have raided the southern road twice this week."
                }
              },
              {
                "col": 11,
                "row": 8,
                "terrain": {
                  "name": "Frost Marsh",
                  "color": "#304652"
                },
                "type": "event",
                "name": "The Pack",
                "data": {
                  "whisper": "Below the pale moon, the pack roams, driven by hunger that none can know.",
                  "mysteries": [
                    "Paw prints in the mud, circling an abandoned camp. Something hunts this stretch of road.",
                    "A wounded traveler stumbles from the trees. The pack took his companions in the dead of night.",
                    "A child sits alone in a clearing, unharmed. The pack circles the treeline, watching.",
                    "A farmstead ravaged. Livestock gone. A carved bone left deliberately behind.",
                    "The Alpha appears on a ridge above you, enormous and silent.",
                    "The pack descends as one. The Alpha leads the charge. Fight or flee."
                  ],
                  "mysteryIdx": 0
                }
              },
              {
                "col": 11,
                "row": 9,
                "terrain": {
                  "name": "Meadow",
                  "color": "#2c4420"
                },
                "type": "temple",
                "name": "Cathedral of Ash",
                "data": {
                  "mood": "Ancient and silent — dust on every surface",
                  "sage": "A quiet sage who only answers questions with questions",
                  "food": "Spiced fish and grain cakes",
                  "goods": "Leather goods and copper fittings",
                  "news": "A messenger from the Seat passed through but never arrived at their destination."
                }
              },
